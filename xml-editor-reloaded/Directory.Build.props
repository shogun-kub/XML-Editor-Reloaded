<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('$(MSBuildThisFileDirectory)src'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Keep every bin/obj under the repository-level "out" folder. The DSH sandbox marks the session
    workspace with a low mandatory integrity label, and executables built inside that tree inherit
    the label: they start at low integrity, where writes to %APPDATA% are denied and the metadata
    database fails to open (SQLite error 14). "out" is excluded from the label, so the built app
    starts normally, and build artifacts stay out of the source tree.
  -->
  <PropertyGroup>
    <ArtifactsPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\out'))</ArtifactsPath>
  </PropertyGroup>

  <!--
    VSTest's testhost opens its parent process with PROCESS_ALL_ACCESS so it can exit when
    vstest.console dies. Inside the DSH sandbox the restricted token only grants the
    workspace SID a file-oriented mask (0x1F01FF), so that OpenProcess fails with
    "access denied" and testhost aborts before running a single test. The supported
    MSTest.EnableParentProcessQuery AppContext switch turns the watcher off; Microsoft's
    own testhost targets use it for UWP. Apply it only in DSH so normal runs keep the
    orphan protection.
  -->
  <PropertyGroup Condition="'$(DSH_SHELL)' == '1' or '$(DSH_SESSION_ID)' != ''">
    <_MSTestEnableParentProcessQuery>false</_MSTestEnableParentProcessQuery>
    <!-- The sandbox has no route to nuget.org; auditing would fail the restore. -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

</Project>
