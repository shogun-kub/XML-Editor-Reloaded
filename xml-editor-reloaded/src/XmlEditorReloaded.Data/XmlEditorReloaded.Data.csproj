<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <!-- Override transitive SQLitePCLRaw.lib.e_sqlite3 to a version without known vulnerabilities (NU1903). -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XmlEditorReloaded.Core\XmlEditorReloaded.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Metadata\Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup Condition="Exists('Help\help.json')">
    <EmbeddedResource Include="Help\help.json" LogicalName="XmlEditorReloaded.Data.Help.help.json" />
  </ItemGroup>

</Project>
