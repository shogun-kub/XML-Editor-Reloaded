<Window x:Class="XmlEditorReloaded.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:XmlEditorReloaded.App.Views"
        xmlns:vm="clr-namespace:XmlEditorReloaded.App.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="780"
        Width="1280"
        MinHeight="520"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Margin="0,0,0,8">
            <MenuItem Header="{Binding FileMenuText}"
                      AutomationProperties.AutomationId="FileMenu">
                <MenuItem Header="{Binding SaveAllText}"
                          AutomationProperties.AutomationId="MenuSaveAll"
                          Command="{Binding SaveAllCommand}" />
                <Separator />
                <MenuItem Header="{Binding SettingsText}"
                          AutomationProperties.AutomationId="SettingsButton"
                          Command="{Binding OpenSettingsCommand}" />
                <Separator />
                <MenuItem Header="{Binding ExitMenuText}"
                          AutomationProperties.AutomationId="ExitMenuItem"
                          Click="OnExitMenuClick" />
            </MenuItem>
            <MenuItem Header="{Binding ViewMenuText}"
                      AutomationProperties.AutomationId="ViewMenu">
                <MenuItem Header="{Binding ResetLayoutText}"
                          AutomationProperties.AutomationId="ResetLayoutButton"
                          Command="{Binding ResetLayoutCommand}" />
            </MenuItem>
            <MenuItem Header="{Binding DataMenuText}"
                      AutomationProperties.AutomationId="DataMenu">
                <MenuItem Header="{Binding BulkEditText}"
                          AutomationProperties.AutomationId="BulkEditButton"
                          Command="{Binding BulkEditCommand}" />
                <Separator />
                <MenuItem Header="{Binding CompareText}"
                          AutomationProperties.AutomationId="CompareButton"
                          Command="{Binding CompareVersionsCommand}" />
                <MenuItem Header="{Binding CopyText}"
                          AutomationProperties.AutomationId="CopyDataButton"
                          Command="{Binding CopyDataCommand}" />
                <Separator />
                <MenuItem Header="{Binding ImagesText}"
                          AutomationProperties.AutomationId="ItemImagesButton"
                          Command="{Binding OpenImageViewerCommand}" />
                <MenuItem Header="{Binding EnemyAmmoText}"
                          AutomationProperties.AutomationId="EnemyAmmoButton"
                          Command="{Binding OpenEnemyAmmoCommand}" />
                <MenuItem Header="{Binding TranslationReportText}"
                          AutomationProperties.AutomationId="TranslationReportButton"
                          Command="{Binding ShowTranslationReportCommand}" />
            </MenuItem>
            <MenuItem Header="{Binding HelpMenuText}"
                      AutomationProperties.AutomationId="HelpMenu">
                <MenuItem Header="{Binding AboutMenuText}"
                          AutomationProperties.AutomationId="AboutMenuItem"
                          Command="{Binding OpenAboutCommand}" />
            </MenuItem>
        </Menu>

        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Text="{Binding DataDirectoryLabel}" />
            <ComboBox Width="320"
                      AutomationProperties.AutomationId="DataDirectoryCombo"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding DataDirectories}"
                      SelectedItem="{Binding SelectedDataDirectory, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName"
                      ToolTip="{Binding DataDirectory}" />
            <Button Margin="8,0,0,0"
                    Padding="12,4"
                    AutomationProperties.AutomationId="BrowseDataDirectoryButton"
                    Content="{Binding BrowseText}"
                    Command="{Binding BrowseCommand}" />
            <Button Margin="8,0,0,0"
                    Padding="12,4"
                    AutomationProperties.AutomationId="RemoveDataDirectoryButton"
                    Content="{Binding RemoveDataDirectoryText}"
                    ToolTip="{Binding RemoveDataDirectoryTooltip}"
                    Command="{Binding RemoveDataDirectoryCommand}"
                    CommandParameter="{Binding SelectedDataDirectory}" />
            <Button Margin="8,0,0,0"
                    Padding="12,4"
                    AutomationProperties.AutomationId="RefreshTablesButton"
                    Content="{Binding RefreshText}"
                    Command="{Binding RefreshCommand}" />
            <Button Margin="8,0,0,0"
                    Padding="12,4"
                    AutomationProperties.AutomationId="SaveAllButton"
                    Content="{Binding SaveAllText}"
                    Command="{Binding SaveAllCommand}" />
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="{Binding TablesLabel}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="TablesGrid"
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              ItemsSource="{Binding Tables}"
                              SelectedItem="{Binding SelectedTable, Mode=TwoWay}"
                              MouseDoubleClick="OnTablesGridDoubleClick">
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding OpenTableCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="TableNameColumn"
                                                Binding="{Binding TableName}"
                                                Width="*" />
                            <DataGridTextColumn x:Name="LanguagesColumn"
                                                Binding="{Binding Languages}"
                                                Width="90" />
                            <DataGridTextColumn x:Name="MappedColumn"
                                                Binding="{Binding MappedText}"
                                                Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="1"
                            Margin="0,6,0,0"
                            Padding="12,4"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="OpenTableButton"
                            Content="{Binding OpenTableText}"
                            Command="{Binding OpenTableCommand}" />

                    <Expander Grid.Row="2"
                              Margin="0,8,0,0"
                              AutomationProperties.AutomationId="DetailsExpander"
                              Header="{Binding DetailsLabel}"
                              IsExpanded="True">
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4">
                                <TextBlock FontWeight="Bold"
                                           Text="{Binding SelectedTable.TableName}" />
                                <TextBlock Margin="0,6,0,0"
                                           AutomationProperties.AutomationId="DetailsText"
                                           Text="{Binding DetailsText}" />
                                <TextBlock Margin="0,4,0,0"
                                           AutomationProperties.AutomationId="DetailsRecordCount"
                                           Text="{Binding RecordCountText}" />
                                <TextBlock Margin="0,12,0,4"
                                           FontWeight="Bold"
                                           Text="{Binding DiagnosticsLabel}" />
                                <ItemsControl AutomationProperties.AutomationId="DiagnosticsList"
                                          ItemsSource="{Binding Diagnostics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,0,0,4"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Expander>
                </Grid>
            </GroupBox>

            <Grid Grid.Column="1">
                <TabControl AutomationProperties.AutomationId="EditorsTabs"
                            ItemsSource="{Binding Editors}"
                            SelectedItem="{Binding SelectedEditor, Mode=TwoWay}">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}" />
                                <TextBlock Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           Foreground="#FF777777"
                                           Text="{Binding DatasetLabel}" />
                                <Button Margin="8,0,0,0"
                                        Padding="5,0"
                                        Content="✕"
                                        Command="{Binding DataContext.CloseEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.Resources>
                        <DataTemplate DataType="{x:Type vm:TableEditorViewModel}">
                            <views:TableView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ItemWorkspaceViewModel}">
                            <views:ItemWorkspaceView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:MercGearWorkspaceViewModel}">
                            <views:MercGearWorkspaceView />
                        </DataTemplate>
                    </TabControl.Resources>
                </TabControl>

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#FF777777"
                           TextWrapping="Wrap"
                           MaxWidth="420"
                           TextAlignment="Center"
                           Text="{Binding EditorPlaceholder}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasEditors}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <ProgressBar Grid.Row="3"
                     Height="4"
                     Margin="0,8,0,0"
                     IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <TextBlock Grid.Row="4"
                   AutomationProperties.AutomationId="StatusText"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Text="{Binding StatusText}" />
    </Grid>
</Window>
