<Window Style="{StaticResource {x:Type Window}}" x:Class="XmlEditorReloaded.App.Views.LookupIdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="460"
        SizeToContent="Height"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,6"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="LookupIdSummaryText"
                   Text="{Binding SummaryText}" />

        <TextBlock Grid.Row="1"
                   Margin="0,0,0,6"
                   Foreground="{DynamicResource Theme.Text.Muted}"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="LookupIdKindHint"
                   Text="{Binding KindHint}" />

        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{Binding IdLabel}" />
            <TextBox Grid.Column="1"
                     VerticalAlignment="Center"
                     AutomationProperties.AutomationId="LookupIdBox"
                     Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="0,0,0,6"
                   Foreground="{DynamicResource Theme.Danger}"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="LookupIdErrorText"
                   Text="{Binding ValidationMessage}" />

        <TextBlock Grid.Row="4"
                   Margin="0,0,0,6"
                   Foreground="{DynamicResource Theme.Warning}"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="LookupIdWarningText"
                   Text="{Binding WarningMessage}" />

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Margin="0,0,6,0"
                    Padding="16,4"
                    AutomationProperties.AutomationId="LookupIdOkButton"
                    IsDefault="True"
                    IsEnabled="{Binding IsValid}"
                    Content="{Binding OkText}"
                    Click="OnOk" />
            <Button Margin="0"
                    Padding="16,4"
                    AutomationProperties.AutomationId="LookupIdCancelButton"
                    IsCancel="True"
                    Content="{Binding CancelText}"
                    Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
