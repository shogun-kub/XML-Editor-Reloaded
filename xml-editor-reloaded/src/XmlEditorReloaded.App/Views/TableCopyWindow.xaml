<Window x:Class="XmlEditorReloaded.App.Views.TableCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="1120"
        Height="780"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Text="{Binding SourceLabel}" />
            <ComboBox Grid.Column="1"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding Directories}"
                      SelectedItem="{Binding SourceDirectory, Mode=TwoWay}"
                      IsEditable="False" />
            <Button Grid.Column="2"
                    Margin="6,0,16,0"
                    Padding="10,3"
                    Content="{Binding BrowseText}"
                    Command="{Binding BrowseSourceCommand}" />
            <TextBlock Grid.Column="3"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Text="{Binding TargetLabel}" />
            <ComboBox Grid.Column="4"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding Directories}"
                      SelectedItem="{Binding TargetDirectory, Mode=TwoWay}"
                      IsEditable="False" />
            <Button Grid.Column="5"
                    Margin="6,0,0,0"
                    Padding="10,3"
                    Content="{Binding BrowseText}"
                    Command="{Binding BrowseTargetCommand}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Text="{Binding TableLabel}" />
            <ComboBox Grid.Column="1"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding Tables}"
                      SelectedItem="{Binding SelectedTable, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName"
                      IsTextSearchEnabled="True" />
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Margin="16,0,8,0"
                       Text="{Binding RecordsLabel}" />
            <StackPanel Grid.Column="3">
                <TextBox VerticalAlignment="Center"
                         Text="{Binding RecordKeysText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,2,0,0"
                           Foreground="#FF666666"
                           TextWrapping="Wrap"
                           Text="{Binding RecordsHint}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Text="{Binding ConflictLabel}" />
            <ComboBox Grid.Column="1"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding ConflictPolicies}"
                      SelectedItem="{Binding SelectedConflictPolicy, Mode=TwoWay}"
                      DisplayMemberPath="Label" />
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Margin="16,0,8,0"
                       Text="{Binding KeyModeLabel}" />
            <ComboBox Grid.Column="3"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding KeyModes}"
                      SelectedItem="{Binding SelectedKeyMode, Mode=TwoWay}"
                      IsEnabled="{Binding IsAllocateAvailable}"
                      DisplayMemberPath="Label" />
            <CheckBox Grid.Column="4"
                      VerticalAlignment="Center"
                      Margin="16,0,0,0"
                      Content="{Binding RelatedLabel}"
                      IsChecked="{Binding CopyRelatedRecords, Mode=TwoWay}" />
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="0,0,0,6"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Text="{Binding SummaryText}" />

        <GroupBox Grid.Row="4"
                  Header="{Binding PreviewHeader}">
            <DataGrid x:Name="PreviewGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      EnableRowVirtualization="True"
                      ItemsSource="{Binding PreviewRows}">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="SourceKeyColumn" Binding="{Binding SourceKey}" Width="90" />
                    <DataGridTextColumn x:Name="SourceDisplayColumn" Binding="{Binding SourceDisplay}" Width="160" />
                    <DataGridTextColumn x:Name="TargetKeyColumn" Binding="{Binding TargetKey}" Width="90" />
                    <DataGridTextColumn x:Name="ActionColumn" Binding="{Binding ActionText}" Width="100" />
                    <DataGridTextColumn x:Name="ReferencesColumn" Binding="{Binding RemapText}" Width="2*" />
                    <DataGridTextColumn x:Name="RelatedColumn" Binding="{Binding RelatedText}" Width="2*" />
                    <DataGridTextColumn x:Name="WarningsColumn" Binding="{Binding WarningText}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Row="5"
                  Margin="0,8,0,0"
                  Header="{Binding WarningsHeader}"
                  Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
            <ListBox MaxHeight="120"
                     ItemsSource="{Binding Warnings}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap" Text="{Binding}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <Grid Grid.Row="6" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Padding="16,4"
                    Content="{Binding PreviewText}"
                    Command="{Binding PreviewCommand}" />
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="16,4"
                    IsDefault="True"
                    Content="{Binding ApplyText}"
                    Command="{Binding ApplyCommand}" />
            <ProgressBar Grid.Column="2"
                         Width="120"
                         Height="4"
                         Margin="12,0,0,0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Button Grid.Column="3"
                    Padding="16,4"
                    IsCancel="True"
                    Content="{Binding CloseText}"
                    Click="OnClose" />
        </Grid>

        <TextBlock Grid.Row="7"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Text="{Binding StatusText}" />
    </Grid>
</Window>
