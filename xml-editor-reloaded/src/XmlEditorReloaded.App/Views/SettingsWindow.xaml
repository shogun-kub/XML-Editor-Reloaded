<Window x:Class="XmlEditorReloaded.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:XmlEditorReloaded.App.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="760"
        Height="620"
        MinWidth="640"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="{Binding DataDirectoriesLabel}" MinHeight="240">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid x:Name="DirectoriesGrid"
                          AutomationProperties.AutomationId="SettingsDirectoriesGrid"
                          Grid.Row="0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          ItemsSource="{Binding Directories}"
                          SelectedItem="{Binding SelectedDirectory, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn x:Name="ActiveColumn"
                                                Binding="{Binding IsActive}"
                                                IsReadOnly="True"
                                                Width="70" />
                        <DataGridTextColumn x:Name="PathColumn"
                                            Binding="{Binding Path}"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1"
                            Margin="0,8,0,0"
                            Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Padding="12,4"
                            AutomationProperties.AutomationId="SettingsAddButton"
                            Content="{Binding AddDirectoryText}"
                            Command="{Binding AddDirectoryCommand}" />
                    <Button Margin="0,0,8,0"
                            Padding="12,4"
                            AutomationProperties.AutomationId="SettingsRemoveButton"
                            Content="{Binding RemoveDirectoryText}"
                            Command="{Binding RemoveDirectoryCommand}" />
                    <Button Padding="12,4"
                            AutomationProperties.AutomationId="SettingsSetActiveButton"
                            Content="{Binding SetActiveText}"
                            Command="{Binding SetActiveDirectoryCommand}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <TextBlock FontWeight="Bold" Text="{Binding ActiveDirectoryLabel}" />
                    <TextBlock Margin="0,2,0,0"
                               AutomationProperties.AutomationId="SettingsActiveDirectoryText"
                               TextWrapping="Wrap"
                               Text="{Binding ActiveDirectoryText}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="{Binding RecentDirectoriesLabel}">
                <ListBox Margin="8"
                         ItemsSource="{Binding RecentDirectories}"
                         IsEnabled="False" />
            </GroupBox>

            <GroupBox Grid.Column="2" Header="{Binding UiLanguageLabel}">
                <StackPanel Margin="8">
                    <ComboBox AutomationProperties.AutomationId="SettingsLanguageCombo"
                              ItemsSource="{Binding UiLanguageOptions}"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName" />
                    <TextBlock Margin="0,8,0,0"
                               AutomationProperties.AutomationId="SettingsLanguageNote"
                               TextWrapping="Wrap"
                               Text="{Binding UiLanguageNote}" />
                </StackPanel>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <Button HorizontalAlignment="Left"
                    Padding="12,4"
                    AutomationProperties.AutomationId="SettingsResetLayoutsButton"
                    Content="{Binding ResetLayoutsText}"
                    Command="{Binding ResetLayoutsCommand}" />
            <TextBlock Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="SettingsResetLayoutsPendingText"
                       Foreground="#FF996600"
                       Text="{Binding ResetLayoutsPendingText}"
                       Visibility="{Binding IsResetLayoutsPending, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="SettingsStatusText"
                       Text="{Binding StatusText}" />
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Margin="0,0,8,0"
                    Padding="20,4"
                    IsDefault="True"
                    AutomationProperties.AutomationId="SettingsOkButton"
                    Content="{Binding OkText}"
                    Click="OnOk" />
            <Button Padding="20,4"
                    IsCancel="True"
                    AutomationProperties.AutomationId="SettingsCancelButton"
                    Content="{Binding CancelText}"
                    Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
