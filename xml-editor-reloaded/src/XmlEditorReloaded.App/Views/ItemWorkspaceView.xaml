<UserControl x:Class="XmlEditorReloaded.App.Views.ItemWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:XmlEditorReloaded.App.Views"
             xmlns:shortcuts="clr-namespace:XmlEditorReloaded.App.Shortcuts"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <DrawingBrush x:Key="CheckerBrush"
                      TileMode="Tile"
                      Viewport="0,0,16,16"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,16,16"
                      ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFF2F2F2">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFD8D8D8">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DataTemplate x:Key="ItemListSectionTemplate">
            <GroupBox Margin="0,6,0,0"
                      Header="{Binding Label}"
                      AutomationProperties.AutomationId="{Binding SectionAutomationId}">
                <StackPanel Margin="6">
                    <TextBlock Foreground="{DynamicResource Theme.Text.Muted}"
                               TextWrapping="Wrap"
                               Text="{Binding CompatibleNote}" />
                    <ItemsControl ItemsSource="{Binding Values}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <views:RelationPicker Grid.Column="0"
                                                          VerticalAlignment="Center"
                                                          RelationData="{Binding Relation}"
                                                          SelectedValue="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Visibility="{Binding HasRelation, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBox Grid.Column="0"
                                             VerticalAlignment="Center"
                                             AutomationProperties.AutomationId="{Binding ValueAutomationId}"
                                             Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Visibility="{Binding IsPlainValue, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Grid.Column="1"
                                            Margin="6,0,0,0"
                                            Padding="8,1"
                                            AutomationProperties.AutomationId="{Binding RemoveAutomationId}"
                                            Content="✕"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=GroupBox}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Margin="0,6,0,0"
                            Padding="10,2"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="{Binding AddAutomationId}"
                            Content="{Binding AddText}"
                            Command="{Binding AddCommand}" />
                </StackPanel>
            </GroupBox>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewItemCommand}" />
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
        <KeyBinding Key="F8" Command="{Binding ValidateCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0">
                <Button Style="{DynamicResource IconButton}"
                        Margin="0,0,4,0"
                        AutomationProperties.AutomationId="ItemUndoButton"
                        AutomationProperties.Name="{Binding UndoText}"
                        Content="{DynamicResource Icon.Undo}"
                        Command="{Binding UndoCommand}"
                        ToolTip="{Binding UndoButtonTooltip}" />
                <Button Style="{DynamicResource IconButton}"
                        Margin="0,0,4,0"
                        AutomationProperties.AutomationId="ItemRedoButton"
                        AutomationProperties.Name="{Binding RedoText}"
                        Content="{DynamicResource Icon.Redo}"
                        Command="{Binding RedoCommand}"
                        ToolTip="{Binding RedoButtonTooltip}" />
                <Button Style="{DynamicResource IconButton}"
                        Margin="0,0,4,0"
                        AutomationProperties.AutomationId="ItemSaveButton"
                        AutomationProperties.Name="{Binding SaveText}"
                        Content="{DynamicResource Icon.Save}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsDirty}"
                        ToolTip="{shortcuts:ShortcutTip Action=Save, Text={Binding SaveText}}" />
                <Button Style="{DynamicResource IconButton}"
                        Margin="0,0,4,0"
                        AutomationProperties.AutomationId="ItemValidateButton"
                        AutomationProperties.Name="{Binding ValidateText}"
                        Content="{DynamicResource Icon.Validate}"
                        Command="{Binding ValidateCommand}"
                        ToolTip="{shortcuts:ShortcutTip Action=Validate, Text={Binding ValidateText}}" />
                <Button Style="{DynamicResource IconButton}"
                        AutomationProperties.AutomationId="ItemReloadButton"
                        AutomationProperties.Name="{Binding ReloadText}"
                        Content="{DynamicResource Icon.Reload}"
                        Command="{Binding ReloadCommand}"
                        ToolTip="{shortcuts:ShortcutTip Action=Reload, Text={Binding ReloadText}}" />
            </WrapPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Margin="6,0,0,0">
                <TextBlock VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           Text="{Binding LanguageLabel}" />
                <ComboBox Width="160"
                          VerticalAlignment="Center"
                          AutomationProperties.AutomationId="ItemLanguageCombo"
                          ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}"
                          DisplayMemberPath="DisplayText"
                          ToolTip="{Binding SelectedLanguageOption.Tooltip}"
                          IsEnabled="{Binding IsLanguageSelectorEnabled}" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1"
                   Margin="0,0,0,6"
                   Foreground="{DynamicResource Theme.Warning}"
                   TextWrapping="Wrap"
                   Text="{Binding WarningsText}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WarningsText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="{Binding Title}" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Text="{Binding SearchLabel}" />
                        <TextBox Grid.Column="1"
                                 MinWidth="40"
                                 AutomationProperties.AutomationId="ItemSearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2"
                                   MaxWidth="90"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource Theme.Text.Muted}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding CountText}"
                                   AutomationProperties.HelpText="{Binding CountText}"
                                   AutomationProperties.AutomationId="ItemCountText"
                                   Text="{Binding CountShortText}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Text="{Binding ClassFilterLabel}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ClassFilterOptions}"
                                  SelectedItem="{Binding SelectedClassFilter, Mode=TwoWay}"
                                  DisplayMemberPath="Label" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Text="{Binding FlagFilterLabel}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding FlagFilterOptions}"
                                  SelectedItem="{Binding SelectedFlagFilter, Mode=TwoWay}"
                                  DisplayMemberPath="Label" />
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox AutomationProperties.AutomationId="ItemGoToIdBox"
                                 Text="{Binding GoToIdText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Margin="6,0,0,0"
                                Padding="10,2"
                                AutomationProperties.AutomationId="ItemGoToIdButton"
                                Content="{Binding GoToIdLabel}"
                                Command="{Binding GoToItemIdCommand}" />
                    </Grid>

                    <Expander Grid.Row="4"
                              Margin="0,0,0,6"
                              Header="{Binding ItemListFilterLabel}"
                              IsExpanded="{Binding IsItemFilterVisible, Mode=TwoWay}">
                        <StackPanel Margin="6,6,0,0">
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock VerticalAlignment="Center"
                                           Margin="0,0,6,0"
                                           Foreground="{DynamicResource Theme.Text.Muted}"
                                           Text="{Binding CustomItemFilter.SummaryText}" />
                                <ComboBox Width="60"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding CustomItemFilter.LogicalOperators}"
                                          SelectedItem="{Binding CustomItemFilter.SelectedLogicalOperator, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayText"
                                          Visibility="{Binding CustomItemFilter.HasMultipleCriteria, Converter={StaticResource BoolToVisibility}}" />
                                <Button Style="{DynamicResource IconButton}"
                                        Margin="0,0,4,0"
                                        AutomationProperties.Name="{Binding FilterAddText}"
                                        Content="{DynamicResource Icon.FilterAdd}"
                                        Command="{Binding CustomItemFilter.AddCriterionCommand}"
                                        ToolTip="{Binding FilterAddText}" />
                                <Button Style="{DynamicResource IconButton}"
                                        AutomationProperties.Name="{Binding FilterClearText}"
                                        Content="{DynamicResource Icon.FilterClear}"
                                        Command="{Binding CustomItemFilter.ClearCommand}"
                                        ToolTip="{Binding FilterClearText}" />
                            </WrapPanel>
                            <Button Style="{DynamicResource IconButton}"
                                    Margin="0,0,0,6"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="{Binding ItemFilterClearText}"
                                    Content="{DynamicResource Icon.FilterClear}"
                                    Command="{Binding ClearItemFiltersCommand}"
                                    ToolTip="{Binding ItemFilterClearText}" />
                            <ItemsControl ItemsSource="{Binding CustomItemFilter.Criteria}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <ComboBox Width="105"
                                                      ItemsSource="{Binding Columns}"
                                                      SelectedItem="{Binding SelectedColumn, Mode=TwoWay}"
                                                      DisplayMemberPath="Name" />
                                            <ComboBox Width="70"
                                                      Margin="6,0,0,0"
                                                      ItemsSource="{Binding Operators}"
                                                      SelectedItem="{Binding SelectedOperator, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayText" />
                                            <TextBox Width="65"
                                                     Margin="6,0,0,0"
                                                     Text="{Binding Operand, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Style="{DynamicResource IconButton}"
                                                    Margin="6,0,0,0"
                                                    AutomationProperties.Name="{Binding DataContext.FilterRemoveText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Content="{DynamicResource Icon.FilterRemove}"
                                                    Command="{Binding RemoveCommand}"
                                                    ToolTip="{Binding DataContext.FilterRemoveText, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <ListBox Grid.Row="5"
                             AutomationProperties.AutomationId="ItemList"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             SelectionChanged="OnItemListSelectionChanged"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="26"
                                            Height="26"
                                            Margin="0,0,6,0"
                                            Background="{StaticResource CheckerBrush}"
                                            BorderBrush="{DynamicResource Theme.Border}"
                                            BorderThickness="1">
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               Loaded="OnItemThumbnailLoaded"
                                               DataContextChanged="OnItemThumbnailDataContextChanged" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayText}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource Theme.Text.Muted}"
                                                   Text="{Binding ClassText}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="6"
                                Orientation="Horizontal"
                                Margin="0,6,0,0">
                        <Button Style="{DynamicResource IconButton}"
                                Margin="0,0,4,0"
                                AutomationProperties.AutomationId="ItemNewButton"
                                AutomationProperties.Name="{Binding NewItemText}"
                                Content="{DynamicResource Icon.NewItem}"
                                Command="{Binding NewItemCommand}"
                                IsEnabled="{Binding IsEditable}"
                                ToolTip="{shortcuts:ShortcutTip Action=NewItem, Text={Binding NewItemText}}" />
                        <Button Style="{DynamicResource IconButton}"
                                Margin="0,0,4,0"
                                AutomationProperties.AutomationId="ItemDuplicateButton"
                                AutomationProperties.Name="{Binding DuplicateItemText}"
                                Content="{DynamicResource Icon.Duplicate}"
                                Command="{Binding DuplicateItemCommand}"
                                IsEnabled="{Binding IsEditable}"
                                ToolTip="{Binding DuplicateItemText}" />
                        <Button Style="{DynamicResource IconButton}"
                                AutomationProperties.AutomationId="ItemDeleteButton"
                                AutomationProperties.Name="{Binding DeleteItemText}"
                                Content="{DynamicResource Icon.Delete}"
                                Command="{Binding DeleteItemCommand}"
                                IsEnabled="{Binding IsEditable}"
                                ToolTip="{Binding DeleteItemText}" />
                    </StackPanel>

                </Grid>
            </GroupBox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               FontSize="15"
                               FontWeight="Bold"
                               AutomationProperties.AutomationId="ItemDetailHeader"
                               Text="{Binding DetailHeader}" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Text="{Binding IdLabel}" />
                        <TextBox Width="90"
                                 AutomationProperties.AutomationId="ItemIdBox"
                                 Text="{Binding ItemIdText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{DynamicResource IconButton}"
                                Margin="6,0,6,0"
                                AutomationProperties.AutomationId="ItemChangeIdButton"
                                AutomationProperties.Name="{Binding ChangeIdText}"
                                Content="{DynamicResource Icon.ChangeId}"
                                Command="{Binding ChangeItemIdCommand}"
                                IsEnabled="{Binding IsEditable}"
                                ToolTip="{Binding ChangeIdText}" />
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Text="{Binding ClassLabel}" />
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   AutomationProperties.AutomationId="ItemClassText"
                                   Text="{Binding ItemClassText}" />
                    </StackPanel>
                </Grid>

                <TabControl Grid.Row="1" AutomationProperties.AutomationId="ItemTabs">
                    <TabItem Header="{Binding FieldsTabText}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="6">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Margin="0,0,6,0"
                                               Text="{Binding ItemFilterLabel}" />
                                    <TextBox Grid.Column="1"
                                             Width="240"
                                             HorizontalAlignment="Left"
                                             AutomationProperties.AutomationId="ItemFieldFilterBox"
                                             Text="{Binding FieldFilter, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding ItemGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Margin="0,3"
                                                      IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Text="{Binding Label}" />
                                                        <TextBlock Margin="6,0,0,0"
                                                                   Foreground="{DynamicResource Theme.Text.Muted}"
                                                                   Text="{Binding FieldCountText}" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <ItemsControl ItemsSource="{Binding Fields}"
                                                              Margin="6,3,0,3">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <views:FieldEditor />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding ListSections}"
                                              Margin="0,6,0,0"
                                              ItemTemplate="{StaticResource ItemListSectionTemplate}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{Binding SubTablesTabText}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SubTableSections}" Margin="6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="0,3" IsExpanded="True">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding Label}" />
                                                    <TextBlock Margin="6,0,0,0"
                                                               Foreground="{DynamicResource Theme.Text.Muted}"
                                                               Text="{Binding StatusText}" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel Margin="6,3,0,3">
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,0,0,6"
                                                            Visibility="{Binding HasRow, Converter={StaticResource InverseBoolToVisibility}}">
                                                    <Button Style="{DynamicResource IconButton}"
                                                            Margin="0,0,4,0"
                                                            AutomationProperties.Name="{Binding CreateText}"
                                                            Content="{DynamicResource Icon.NewItem}"
                                                            Command="{Binding CreateCommand}"
                                                            ToolTip="{Binding CreateText}" />
                                                    <TextBlock Margin="6,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Theme.Text.Muted}"
                                                               Text="{Binding SharedNote}" />
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding Fields}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <views:FieldEditor Margin="0,0,6,0" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding ListSections}"
                                                              Margin="0,6,0,0"
                                                              ItemTemplate="{StaticResource ItemListSectionTemplate}" />
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{Binding ChildTablesTabText}">
                        <TabControl ItemsSource="{Binding VisibleChildSections}">
                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}" />
                                        <TextBlock Margin="6,0,0,0"
                                                   Foreground="{DynamicResource Theme.Text.Muted}"
                                                   Text="{Binding CountText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button Style="{DynamicResource IconButton}"
                                                    Margin="0,0,4,0"
                                                    AutomationProperties.Name="{Binding AddText}"
                                                    Content="{DynamicResource Icon.AddRow}"
                                                    Command="{Binding Editor.AddRowCommand}"
                                                    IsEnabled="{Binding Editor.IsEditable}"
                                                    ToolTip="{Binding AddText}" />
                                            <Button Style="{DynamicResource IconButton}"
                                                    AutomationProperties.Name="{Binding DeleteText}"
                                                    Content="{DynamicResource Icon.Delete}"
                                                    Command="{Binding Editor.DeleteRowCommand}"
                                                    IsEnabled="{Binding Editor.IsEditable}"
                                                    ToolTip="{Binding DeleteText}" />
                                        </StackPanel>
                                        <views:TableView Grid.Row="1" DataContext="{Binding Editor}" />
                                    </Grid>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </TabItem>

                    <TabItem Header="{Binding ShopkeeperTabText}">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Margin="0,0,0,6"
                                       Foreground="{DynamicResource Theme.Text.Muted}"
                                       AutomationProperties.AutomationId="ShopkeeperCountText"
                                       Text="{Binding ShopkeeperCountText}" />
                            <Grid Grid.Row="1" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding ShopkeeperDealerColumn}" />
                                <TextBlock Grid.Column="1"
                                           FontWeight="SemiBold"
                                           Text="{Binding ShopkeeperQuantityColumn}" />
                            </Grid>
                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl AutomationProperties.AutomationId="ShopkeeperEntries"
                                              ItemsSource="{Binding ShopkeeperEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding DealerName}" />
                                                <TextBox Grid.Column="1"
                                                         Margin="6,0,0,0"
                                                         AutomationProperties.AutomationId="ShopkeeperQuantityBox"
                                                         AutomationProperties.Name="{Binding DealerName}"
                                                         Text="{Binding Quantity, UpdateSourceTrigger=LostFocus}" />
                                                <Button Grid.Column="2"
                                                        Style="{DynamicResource IconButton}"
                                                        Margin="6,0,0,0"
                                                        AutomationProperties.Name="{Binding DataContext.ShopkeeperRemoveText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding RemoveCommand}"
                                                        Content="{DynamicResource Icon.Delete}"
                                                        IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ToolTip="{Binding DataContext.ShopkeeperRemoveText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Grid.Row="2"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource Theme.Text.Muted}"
                                       TextWrapping="Wrap"
                                       Text="{Binding ShopkeeperEmptyText}"
                                       Visibility="{Binding HasShopkeeperEntries, Converter={StaticResource InverseBoolToVisibility}}" />
                            <StackPanel Grid.Row="3"
                                        Margin="0,6,0,0"
                                        Orientation="Horizontal"
                                        Visibility="{Binding CanShowShopkeeperAddBar, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding ShopkeeperAddDealerLabel}" />
                                <ComboBox Width="200"
                                          Margin="6,0,0,0"
                                          AutomationProperties.AutomationId="ShopkeeperDealerCombo"
                                          DisplayMemberPath="DealerName"
                                          IsEnabled="{Binding IsEditable}"
                                          ItemsSource="{Binding ShopkeeperDealerOptions}"
                                          SelectedItem="{Binding SelectedShopkeeperDealer, Mode=TwoWay}" />
                                <TextBlock Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding ShopkeeperQuantityColumn}" />
                                <TextBox Width="90"
                                         Margin="6,0,0,0"
                                         AutomationProperties.AutomationId="ShopkeeperNewQuantityBox"
                                         IsEnabled="{Binding IsEditable}"
                                         Text="{Binding NewShopkeeperQuantity, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding ShopkeeperQuantityColumn}" />
                                <Button Style="{DynamicResource IconButton}"
                                        Margin="6,0,0,0"
                                        AutomationProperties.AutomationId="ShopkeeperAddButton"
                                        AutomationProperties.Name="{Binding ShopkeeperAddText}"
                                        Command="{Binding AddShopkeeperEntryCommand}"
                                        Content="{DynamicResource Icon.Add}"
                                        ToolTip="{Binding ShopkeeperAddText}" />
                                <TextBlock Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Theme.Text.Muted}"
                                           Text="{Binding ShopkeeperNoDealersText}"
                                           Visibility="{Binding HasShopkeeperDealerOptions, Converter={StaticResource InverseBoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{Binding NestedTabText}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding NestedGroups}" Margin="6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="0,3"
                                                  IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding Label}" />
                                                    <TextBlock Margin="6,0,0,0"
                                                               Foreground="{DynamicResource Theme.Text.Muted}"
                                                               Text="{Binding FieldCountText}" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Fields}"
                                                          Margin="6,3,0,3">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <views:FieldEditor Margin="0,0,6,0" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{Binding ImagesTabText}">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0" Margin="0,0,6,0">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding GraphicImageListLabel}" />
                                    <TextBlock Foreground="{DynamicResource Theme.Text.Muted}"
                                               AutomationProperties.AutomationId="ItemGraphicImageListInfo"
                                               Text="{Binding GraphicImageListInfo}" />
                                </StackPanel>
                                <ListBox AutomationProperties.AutomationId="ItemImageList"
                                         ItemsSource="{Binding GraphicImages}"
                                         SelectedItem="{Binding SelectedGraphicImage, Mode=TwoWay}"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="40"
                                                        Height="40"
                                                        Background="{StaticResource CheckerBrush}"
                                                        BorderBrush="{DynamicResource Theme.Border}"
                                                        BorderThickness="1">
                                                    <Image Source="{Binding Thumbnail}"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                           Loaded="OnGraphicImageThumbnailLoaded"
                                                           DataContextChanged="OnGraphicImageThumbnailDataContextChanged" />
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding DisplayText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <ScrollViewer Grid.Column="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock VerticalAlignment="Center"
                                                   Margin="0,0,6,0"
                                                   Text="{Binding GraphicTypeLabel}" />
                                        <ComboBox Width="180"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.AutomationId="ItemGraphicTypeCombo"
                                                  ItemsSource="{Binding GraphicTypes}"
                                                  SelectedItem="{Binding SelectedGraphicType, Mode=TwoWay}"
                                                  DisplayMemberPath="Text" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding DetailImages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Text="{Binding Label}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="6,0,0,0"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource Theme.Text.Muted}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   AutomationProperties.AutomationId="{Binding InfoAutomationId}"
                                                                   Text="{Binding InfoText}" />
                                                    </Grid>
                                                    <Border Grid.Row="1"
                                                            Height="{Binding PanelHeight}"
                                                            Margin="0,6,0,0"
                                                            Background="{StaticResource CheckerBrush}"
                                                            BorderBrush="{DynamicResource Theme.Border}"
                                                            BorderThickness="1">
                                                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                                      VerticalScrollBarVisibility="Auto">
                                                            <Image Source="{Binding Image}"
                                                                   Stretch="None"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                                   SnapsToDevicePixels="True" />
                                                        </ScrollViewer>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Expander Grid.Row="3"
                  Margin="0,6,0,0"
                  AutomationProperties.AutomationId="ItemValidationExpander"
                  Header="{Binding ValidationLabel}"
                  IsExpanded="{Binding IsValidationVisible, Mode=TwoWay}">
            <ListBox Height="110"
                     Margin="6,6,0,0"
                     AutomationProperties.AutomationId="ItemValidationList"
                     ItemsSource="{Binding ValidationIssues}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Expander>

        <Grid Grid.Row="4" Margin="0,6,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar Grid.Row="0"
                         Height="4"
                         IsIndeterminate="True">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <TextBlock Grid.Row="1"
                       Margin="0,6,0,0"
                       AutomationProperties.AutomationId="ItemStatus"
                       TextWrapping="Wrap"
                       Text="{Binding StatusText}" />
        </Grid>
    </Grid>
</UserControl>
