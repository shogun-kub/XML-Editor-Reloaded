<UserControl x:Class="XmlEditorReloaded.App.Views.MercGearWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:XmlEditorReloaded.App.Views"
             xmlns:shortcuts="clr-namespace:XmlEditorReloaded.App.Shortcuts"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
        <KeyBinding Key="F8" Command="{Binding ValidateCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0">
                <Button Style="{DynamicResource IconButton}"
                        Margin="0,0,4,0"
                        AutomationProperties.AutomationId="MercUndoButton"
                        AutomationProperties.Name="{Binding UndoText}"
                        Content="{DynamicResource Icon.Undo}"
                        Command="{Binding UndoCommand}"
                        ToolTip="{Binding UndoButtonTooltip}" />
                <Button Style="{DynamicResource IconButton}"
                        Margin="0,0,4,0"
                        AutomationProperties.AutomationId="MercRedoButton"
                        AutomationProperties.Name="{Binding RedoText}"
                        Content="{DynamicResource Icon.Redo}"
                        Command="{Binding RedoCommand}"
                        ToolTip="{Binding RedoButtonTooltip}" />
                <Button Style="{DynamicResource IconButton}"
                        Margin="0,0,4,0"
                        AutomationProperties.AutomationId="MercSaveButton"
                        AutomationProperties.Name="{Binding SaveText}"
                        Content="{DynamicResource Icon.Save}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsDirty}"
                        ToolTip="{shortcuts:ShortcutTip Action=Save, Text={Binding SaveText}}" />
                <Button Style="{DynamicResource IconButton}"
                        Margin="0,0,4,0"
                        AutomationProperties.AutomationId="MercValidateButton"
                        AutomationProperties.Name="{Binding ValidateText}"
                        Content="{DynamicResource Icon.Validate}"
                        Command="{Binding ValidateCommand}"
                        ToolTip="{shortcuts:ShortcutTip Action=Validate, Text={Binding ValidateText}}" />
                <Button Style="{DynamicResource IconButton}"
                        AutomationProperties.AutomationId="MercReloadButton"
                        AutomationProperties.Name="{Binding ReloadText}"
                        Content="{DynamicResource Icon.Reload}"
                        Command="{Binding ReloadCommand}"
                        ToolTip="{shortcuts:ShortcutTip Action=Reload, Text={Binding ReloadText}}" />
            </WrapPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="6,0,0,0">
                <TextBlock VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           Text="{Binding LanguageLabel}" />
                <ComboBox Width="190"
                          VerticalAlignment="Center"
                          AutomationProperties.AutomationId="MercLanguageCombo"
                          ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}"
                          DisplayMemberPath="DisplayText"
                          ToolTip="{Binding SelectedLanguageOption.Tooltip}"
                          IsEnabled="{Binding IsLanguageSelectorEnabled}" />
            </StackPanel>
            <TextBlock Grid.Column="2"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Theme.Text.Muted}"
                       AutomationProperties.AutomationId="MercCountText"
                       Text="{Binding CountText}" />
        </Grid>

        <TextBlock Grid.Row="1"
                   Margin="0,0,0,6"
                   Foreground="{DynamicResource Theme.Warning}"
                   TextWrapping="Wrap"
                   Text="{Binding WarningsText}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WarningsText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="{Binding Title}" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Text="{Binding SearchLabel}" />
                        <TextBox Grid.Column="1"
                                 AutomationProperties.AutomationId="MercSearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <ListBox Grid.Row="1"
                             AutomationProperties.AutomationId="MercList"
                             ItemsSource="{Binding Mercs}"
                             SelectedItem="{Binding SelectedMerc, Mode=TwoWay}"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="3"
                                           Text="{Binding DisplayText}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="0,0,0,6"
                           FontSize="15"
                           FontWeight="Bold"
                           AutomationProperties.AutomationId="MercDetailHeader"
                           Text="{Binding DetailHeader}" />

                <TabControl Grid.Row="1"
                            AutomationProperties.AutomationId="MercKitTabs"
                            ItemsSource="{Binding Kits}"
                            IsEnabled="{Binding IsEditable}">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Header}" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <ScrollViewer Margin="6"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"
                                                   Text="{Binding NameLabel}" />
                                        <TextBox Grid.Row="0"
                                                 Grid.Column="1"
                                                 MinWidth="220"
                                                 AutomationProperties.AutomationId="MercKitNameBox"
                                                 MaxLength="{Binding NameMaxLength}"
                                                 Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="2"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Theme.Warning}"
                                                   Text="{Binding NameMarker}"
                                                   ToolTip="{Binding NameMarkerTooltip}"
                                                   Visibility="{Binding ShowNameMarker, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="3"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"
                                                   Text="{Binding PriceModLabel}" />
                                        <TextBox Grid.Row="0"
                                                 Grid.Column="4"
                                                 Width="70"
                                                 AutomationProperties.AutomationId="MercPriceModBox"
                                                 Text="{Binding PriceMod, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="3"
                                                   VerticalAlignment="Center"
                                                   Margin="6,6,6,0"
                                                   Text="{Binding AbsolutePriceLabel}" />
                                        <TextBox Grid.Row="1"
                                                 Grid.Column="4"
                                                 Width="70"
                                                 Margin="0,6,0,0"
                                                 AutomationProperties.AutomationId="MercAbsolutePriceBox"
                                                 Text="{Binding AbsolutePrice, UpdateSourceTrigger=LostFocus}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Headers.Item}" />
                                        <TextBlock Grid.Column="2"
                                                   Margin="6,0,0,0"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Headers.Status}" />
                                        <TextBlock Grid.Column="3"
                                                   Margin="6,0,0,0"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Headers.Quantity}" />
                                        <TextBlock Grid.Column="4"
                                                   Margin="6,0,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Headers.Drop}" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Slots}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="50" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center"
                                                               Text="{Binding Label}" />
                                                    <views:RelationPicker Grid.Column="1"
                                                                          VerticalAlignment="Center"
                                                                          AutomationId="{Binding ItemField}"
                                                                          RelationData="{Binding Relation}"
                                                                          SelectedValue="{Binding ItemId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          Visibility="{Binding HasRelation, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBox Grid.Column="1"
                                                             VerticalAlignment="Center"
                                                             Text="{Binding ItemId, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             Visibility="{Binding IsPlainValue, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBox Grid.Column="2"
                                                             Margin="6,0,0,0"
                                                             VerticalAlignment="Center"
                                                             AutomationProperties.AutomationId="{Binding StatusField}"
                                                             Text="{Binding Status, UpdateSourceTrigger=LostFocus}" />
                                                    <TextBox Grid.Column="3"
                                                             Margin="6,0,0,0"
                                                             VerticalAlignment="Center"
                                                             AutomationProperties.AutomationId="{Binding QuantityField}"
                                                             Text="{Binding Quantity, UpdateSourceTrigger=LostFocus}"
                                                             Visibility="{Binding SupportsQuantity, Converter={StaticResource BoolToVisibility}}" />
                                                    <CheckBox Grid.Column="4"
                                                              Margin="6,0,0,0"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              AutomationProperties.AutomationId="{Binding DropField}"
                                                              IsChecked="{Binding IsDrop, Mode=TwoWay}"
                                                              Visibility="{Binding SupportsDrop, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Grid>
        </Grid>

        <Expander Grid.Row="3"
                  Margin="0,6,0,0"
                  AutomationProperties.AutomationId="MercValidationExpander"
                  Header="{Binding ValidationLabel}"
                  IsExpanded="{Binding IsValidationVisible, Mode=TwoWay}">
            <ListBox Height="110"
                     Margin="6,6,0,0"
                     AutomationProperties.AutomationId="MercValidationList"
                     ItemsSource="{Binding ValidationIssues}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Expander>

        <Grid Grid.Row="4" Margin="0,6,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar Grid.Row="0"
                         Height="4"
                         IsIndeterminate="True">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <TextBlock Grid.Row="1"
                       Margin="0,6,0,0"
                       AutomationProperties.AutomationId="MercStatus"
                       TextWrapping="Wrap"
                       Text="{Binding StatusText}" />
        </Grid>
    </Grid>
</UserControl>
