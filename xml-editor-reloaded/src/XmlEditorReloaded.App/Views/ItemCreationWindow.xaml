<Window x:Class="XmlEditorReloaded.App.Views.ItemCreationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="420"
        SizeToContent="Height"
        MinWidth="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{Binding IdLabel}" />
            <TextBox Grid.Column="1"
                     VerticalAlignment="Center"
                     AutomationProperties.AutomationId="ItemCreationIdBox"
                     Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{Binding NameLabel}" />
            <TextBox Grid.Column="1"
                     VerticalAlignment="Center"
                     AutomationProperties.AutomationId="ItemCreationNameBox"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{Binding ClassLabel}" />
            <ComboBox Grid.Column="1"
                      VerticalAlignment="Center"
                      AutomationProperties.AutomationId="ItemCreationClassCombo"
                      ItemsSource="{Binding Classes}"
                      SelectedItem="{Binding SelectedClass, Mode=TwoWay}"
                      DisplayMemberPath="DisplayText" />
        </Grid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Margin="0,0,6,0"
                    Padding="16,4"
                    AutomationProperties.AutomationId="ItemCreationOkButton"
                    IsDefault="True"
                    IsEnabled="{Binding IsValid}"
                    Content="{Binding OkText}"
                    Click="OnOk" />
            <Button Margin="0"
                    Padding="16,4"
                    AutomationProperties.AutomationId="ItemCreationCancelButton"
                    IsCancel="True"
                    Content="{Binding CancelText}"
                    Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
