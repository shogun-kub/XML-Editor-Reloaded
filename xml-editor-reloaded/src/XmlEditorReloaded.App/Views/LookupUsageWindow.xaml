<Window Style="{StaticResource {x:Type Window}}" x:Class="XmlEditorReloaded.App.Views.LookupUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="820"
        Height="480"
        MinWidth="600"
        MinHeight="340"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,6"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="LookupUsageSummaryText"
                   Text="{Binding SummaryText}" />

        <Grid Grid.Row="1">
            <DataGrid x:Name="UsageGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      AutomationProperties.AutomationId="LookupUsageGrid"
                      ItemsSource="{Binding Usages}"
                      SelectedItem="{Binding SelectedUsage, Mode=TwoWay}"
                      MouseDoubleClick="OnRowDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding TableText}" Width="170" />
                    <DataGridTextColumn Binding="{Binding RecordText}" Width="100" />
                    <DataGridTextColumn Binding="{Binding FieldPath}" Width="220" />
                    <DataGridTextColumn Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Theme.Text.Muted}"
                       AutomationProperties.AutomationId="LookupUsageEmptyText"
                       Text="{Binding EmptyText}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <StackPanel Grid.Row="2"
                    Margin="0,6,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Margin="0,0,6,0"
                    Padding="16,4"
                    AutomationProperties.AutomationId="LookupUsageOpenButton"
                    IsDefault="True"
                    Content="{Binding OpenText}"
                    Click="OnOpen" />
            <Button Margin="0"
                    Padding="16,4"
                    AutomationProperties.AutomationId="LookupUsageCloseButton"
                    IsCancel="True"
                    Content="{Binding CloseText}"
                    Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
