<Window Style="{StaticResource {x:Type Window}}" x:Class="XmlEditorReloaded.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:XmlEditorReloaded.App.Views"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Icon="pack://application:,,,/XmlEditorReloaded.App;component/Assets/app.ico"
        AutomationProperties.AutomationId="HelpWindow"
        Width="980"
        Height="720"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <views:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,8"
                   FontSize="20"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="HelpTitleText"
                   Text="{Binding TableTitle}" />

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Theme.Text.Muted}"
                       Text="{Binding SearchLabel}" />
            <TextBox x:Name="SearchBox"
                     Grid.Column="1"
                     Margin="0,0,6,0"
                     VerticalContentAlignment="Center"
                     AutomationProperties.AutomationId="HelpSearchBox"
                     AutomationProperties.Name="{Binding SearchLabel}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="OnSearchKeyDown" />
            <Button Grid.Column="2"
                    Margin="0,0,4,0"
                    Padding="10,2"
                    AutomationProperties.AutomationId="HelpSearchButton"
                    Content="{Binding SearchButtonText}"
                    Command="{Binding SearchCommand}" />
            <Button Grid.Column="3"
                    Padding="10,2"
                    AutomationProperties.AutomationId="HelpClearSearchButton"
                    Content="{Binding ClearSearchText}"
                    Command="{Binding ClearSearchCommand}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="0,0,0,4"
                           FontWeight="SemiBold"
                           Text="{Binding FieldsLabel}"
                           Visibility="{Binding IsTableMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBox Grid.Row="1"
                         Margin="0,0,0,4"
                         AutomationProperties.AutomationId="HelpFieldFilterBox"
                         AutomationProperties.Name="{Binding FieldFilterLabel}"
                         Text="{Binding FieldFilter, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsTableMode, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <ListBox x:Name="FieldsList"
                         Grid.Row="2"
                         AutomationProperties.AutomationId="HelpFieldsList"
                         AutomationProperties.Name="{Binding FieldsLabel}"
                         ItemsSource="{Binding Fields}"
                         SelectedItem="{Binding SelectedField, Mode=TwoWay}"
                         Visibility="{Binding IsTableMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,3">
                                <TextBlock FontFamily="Consolas" Text="{Binding Name}" />
                                <TextBlock Foreground="{DynamicResource Theme.Text.Muted}"
                                           FontSize="11"
                                           Text="{Binding Type}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="2"
                      Visibility="{Binding IsSearchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="SearchResultsList"
                             Grid.Row="0"
                             AutomationProperties.AutomationId="HelpSearchResults"
                             ItemsSource="{Binding SearchResults}"
                             SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                             MouseDoubleClick="OnSearchResultDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,3">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource Theme.Text.Muted}"
                                               FontSize="11"
                                               Text="{Binding Snippet}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="1"
                            Margin="0,6,0,0"
                            Padding="10,2"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="HelpOpenSearchResultButton"
                            Content="{Binding OpenResultText}"
                            Command="{Binding OpenSearchResultCommand}"
                            CommandParameter="{Binding SelectedSearchResult}" />
                </Grid>

                <TextBlock Grid.Row="3"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource Theme.Text.Muted}"
                           TextWrapping="Wrap"
                           Text="{Binding StatusText}" />
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="HelpTableTitleText"
                                   Text="{Binding TableTitle}" />
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Padding="10,2"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="HelpOpenTableButton"
                                Content="{Binding OpenTableText}"
                                Command="{Binding OpenTableCommand}"
                                Visibility="{Binding HasTable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <TextBlock Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="HelpSummaryText"
                               Text="{Binding Summary}" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource Theme.Text.Muted}"
                               AutomationProperties.AutomationId="HelpDocumentPathText"
                               Text="{Binding DocumentPath}" />

                    <Border Margin="0,10,0,0"
                            Padding="10"
                            BorderBrush="{DynamicResource Theme.Border}"
                            BorderThickness="1"
                            Visibility="{Binding HasMissingField, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="HelpMissingFieldText"
                                       Text="{Binding MissingFieldText}" />
                            <Button Margin="0,6,0,0"
                                    Padding="8,1"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.AutomationId="HelpCoverageButton"
                                    Content="{Binding CoverageLinkText}"
                                    Command="{Binding OpenCoverageCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,10,0,0"
                            Padding="10"
                            BorderBrush="{DynamicResource Theme.Border}"
                            BorderThickness="1"
                            Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock FontFamily="Consolas"
                                       FontSize="16"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="HelpFieldPathText"
                                       Text="{Binding SelectedField.Path}" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{DynamicResource Theme.Text.Muted}"
                                       Text="{Binding SelectedField.Type}" />
                            <TextBlock Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="HelpFieldDescriptionText"
                                       Text="{Binding SelectedField.Description}" />

                            <TextBlock Margin="0,8,0,2"
                                       FontWeight="SemiBold"
                                       Text="{Binding NumericLabel}"
                                       Visibility="{Binding SelectedField.HasNumericSemantics, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock TextWrapping="Wrap"
                                       Text="{Binding SelectedField.NumericSemantics}"
                                       Visibility="{Binding SelectedField.HasNumericSemantics, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Margin="0,8,0,2"
                                       FontWeight="SemiBold"
                                       Text="{Binding OnlyUsedWithLabel}"
                                       Visibility="{Binding SelectedField.HasOnlyUsedWith, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock TextWrapping="Wrap"
                                       Text="{Binding SelectedField.OnlyUsedWith}"
                                       Visibility="{Binding SelectedField.HasOnlyUsedWith, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Margin="0,8,0,2"
                                       FontWeight="SemiBold"
                                       Text="{Binding ValuesLabel}"
                                       Visibility="{Binding SelectedField.HasValues, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock TextWrapping="Wrap"
                                       Text="{Binding SelectedField.Values}"
                                       Visibility="{Binding SelectedField.HasValues, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Margin="0,8,0,2"
                                       FontWeight="SemiBold"
                                       Text="{Binding DefaultLabel}"
                                       Visibility="{Binding SelectedField.HasDefault, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock TextWrapping="Wrap"
                                       Text="{Binding SelectedField.Default}"
                                       Visibility="{Binding SelectedField.HasDefault, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Margin="0,8,0,2"
                                       FontWeight="SemiBold"
                                       Text="{Binding SourceLabel}" />
                            <TextBlock TextWrapping="Wrap"
                                       Text="{Binding SelectedField.Source}" />
                            <TextBlock Margin="0,8,0,2"
                                       FontWeight="SemiBold"
                                       Text="{Binding ConfidenceLabel}" />
                            <TextBlock Text="{Binding SelectedField.Confidence}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,10,0,4"
                               FontWeight="SemiBold"
                               Text="{Binding LinksLabel}"
                               Visibility="{Binding HasLinks, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ItemsControl ItemsSource="{Binding Links}"
                                  Visibility="{Binding HasLinks, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,1"
                                        Padding="0"
                                        HorizontalAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        AutomationProperties.AutomationId="{Binding DisplayName}"
                                        AutomationProperties.Name="{Binding DisplayName}"
                                        Command="{Binding DataContext.OpenLinkCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding DisplayName}" TextDecorations="Underline" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,10,0,4"
                               FontWeight="SemiBold"
                               Text="{Binding SectionsLabel}"
                               Visibility="{Binding HasSections, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ItemsControl ItemsSource="{Binding Sections}"
                                  Visibility="{Binding HasSections, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Heading}" />
                                    <TextBlock TextWrapping="Wrap" Text="{Binding Text}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,12,0,0"
                               Foreground="{DynamicResource Theme.Text.Muted}"
                               TextWrapping="Wrap"
                               Text="{Binding EmptyText}"
                               Visibility="{Binding HasTable, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1"
                    Padding="16,4"
                    MinWidth="90"
                    AutomationProperties.AutomationId="HelpCloseButton"
                    Content="{Binding CloseText}"
                    IsDefault="True"
                    Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
