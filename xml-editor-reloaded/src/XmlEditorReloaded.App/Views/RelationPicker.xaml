<UserControl x:Class="XmlEditorReloaded.App.Views.RelationPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="ValueBox"
                 VerticalContentAlignment="Center"
                 TextChanged="OnTextChanged"
                 PreviewKeyDown="OnPreviewKeyDown"
                 GotKeyboardFocus="OnGotKeyboardFocus" />
        <ToggleButton x:Name="DropDownButton"
                      Grid.Column="1"
                      Margin="3,0,0,0"
                      Width="18"
                      Padding="0"
                      Focusable="False"
                      Content="▾"
                      Click="OnDropDownClick" />
        <Popup x:Name="OptionsPopup"
               PlacementTarget="{Binding ElementName=ValueBox}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Closed="OnPopupClosed">
            <Border Background="White"
                    BorderBrush="{DynamicResource Theme.Border}"
                    BorderThickness="1"
                    MinWidth="{Binding ActualWidth, ElementName=ValueBox}">
                <ListBox x:Name="OptionsList"
                         MaxHeight="260"
                         Focusable="False"
                         DisplayMemberPath="DropdownText"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonUp="OnOptionClicked" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
