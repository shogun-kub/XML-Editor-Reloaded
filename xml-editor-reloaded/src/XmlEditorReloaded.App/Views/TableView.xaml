<UserControl x:Class="XmlEditorReloaded.App.Views.TableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:XmlEditorReloaded.App.Views"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <DrawingBrush x:Key="CheckerBrush"
                      TileMode="Tile"
                      Viewport="0,0,16,16"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,16,16"
                      ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFF2F2F2">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFD8D8D8">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0"
                   Margin="0,0,0,6"
                   Visibility="{Binding IsEmbedded, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock FontSize="15"
                       AutomationProperties.AutomationId="TableTitle"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Text="{Binding Title}" />
            <TextBlock Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#FF666666"
                       Text="{Binding LanguageText}" />
            <TextBlock Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       AutomationProperties.AutomationId="TableRecordCount"
                       Text="{Binding RecordCountText}" />
            <StackPanel Margin="12,0,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           Text="{Binding SearchLabel}" />
                <TextBox Width="220"
                         VerticalAlignment="Center"
                         AutomationProperties.AutomationId="SearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </WrapPanel>

        <Grid Grid.Row="1"
              Margin="0,0,0,0"
              Visibility="{Binding IsEmbedded, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0">
                <WrapPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="0,0,6,8" />
                    </Style>
                </WrapPanel.Resources>
                <Button Padding="10,3"
                        AutomationProperties.AutomationId="UndoButton"
                        Content="{Binding UndoText}"
                        Command="{Binding UndoCommand}"
                        ToolTip="{Binding UndoButtonTooltip}" />
                <Button Padding="10,3"
                        Margin="0,0,12,8"
                        AutomationProperties.AutomationId="RedoButton"
                        Content="{Binding RedoText}"
                        Command="{Binding RedoCommand}"
                        ToolTip="{Binding RedoButtonTooltip}" />
                <Button Padding="10,3"
                        AutomationProperties.AutomationId="AddRowButton"
                        Content="{Binding AddRowText}"
                        Command="{Binding AddRowCommand}"
                        IsEnabled="{Binding IsEditable}" />
                <Button Padding="10,3"
                        AutomationProperties.AutomationId="DuplicateRowButton"
                        Content="{Binding DuplicateRowText}"
                        Command="{Binding DuplicateRowCommand}"
                        IsEnabled="{Binding IsEditable}" />
                <Button Padding="10,3"
                        AutomationProperties.AutomationId="DeleteRowButton"
                        Content="{Binding DeleteRowText}"
                        Command="{Binding DeleteRowCommand}"
                        IsEnabled="{Binding IsEditable}" />
                <Button Padding="10,3"
                        AutomationProperties.AutomationId="SaveButton"
                        Content="{Binding SaveText}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsDirty}" />
                <TextBlock VerticalAlignment="Center"
                           Margin="0,0,12,8"
                           Foreground="#FF666666"
                           AutomationProperties.AutomationId="SelectedRowCount"
                           Text="{Binding SelectedRowCountText}" />
                <Button Padding="10,3"
                        AutomationProperties.AutomationId="ValidateButton"
                        Content="{Binding ValidateText}"
                        Command="{Binding ValidateCommand}" />
                <Button Padding="10,3"
                        Margin="0,0,12,8"
                        AutomationProperties.AutomationId="ReloadButton"
                        Content="{Binding ReloadText}"
                        Command="{Binding ReloadCommand}" />
            </WrapPanel>
            <StackPanel Grid.Column="1"
                        Margin="16,0,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">
                <TextBlock VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           Text="{Binding LanguageLabel}" />
                <ComboBox Width="210"
                          VerticalAlignment="Center"
                          AutomationProperties.AutomationId="LanguageCombo"
                          ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}"
                          DisplayMemberPath="DisplayText"
                          ToolTip="{Binding SelectedLanguageOption.Tooltip}"
                          IsEnabled="{Binding IsLanguageSelectorEnabled}" />
            </StackPanel>
        </Grid>

        <Expander Grid.Row="2"
                  Margin="0,0,0,6"
                  Visibility="{Binding IsEmbedded, Converter={StaticResource InverseBoolToVisibility}}"
                  AutomationProperties.AutomationId="FilterExpander"
                  Header="{Binding FilterLabel}"
                  IsExpanded="{Binding IsFilterVisible, Mode=TwoWay}">
            <StackPanel Margin="4,4,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="#FF666666"
                               AutomationProperties.AutomationId="FilterSummary"
                               Text="{Binding Filter.SummaryText}" />
                    <ComboBox Width="150"
                              Margin="12,0,6,0"
                              VerticalAlignment="Center"
                              AutomationProperties.AutomationId="FilterLogicalOperatorCombo"
                              ItemsSource="{Binding Filter.LogicalOperators}"
                              SelectedItem="{Binding Filter.SelectedLogicalOperator, Mode=TwoWay}"
                              DisplayMemberPath="DisplayText"
                              Visibility="{Binding Filter.HasMultipleCriteria, Converter={StaticResource BoolToVisibility}}" />
                    <Button Padding="10,2"
                            Margin="0,0,6,0"
                            AutomationProperties.AutomationId="FilterAddButton"
                            Content="{Binding FilterAddText}"
                            Command="{Binding Filter.AddCriterionCommand}" />
                    <Button Padding="10,2"
                            Margin="0,0,12,0"
                            AutomationProperties.AutomationId="FilterClearButton"
                            Content="{Binding FilterClearText}"
                            Command="{Binding ClearFilterCommand}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Filter.Criteria}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <ComboBox Width="230"
                                          AutomationProperties.AutomationId="FilterColumnCombo"
                                          ItemsSource="{Binding Columns}"
                                          SelectedItem="{Binding SelectedColumn, Mode=TwoWay}"
                                          DisplayMemberPath="Name" />
                                <ComboBox Width="150"
                                          Margin="6,0,0,0"
                                          AutomationProperties.AutomationId="FilterOperatorCombo"
                                          ItemsSource="{Binding Operators}"
                                          SelectedItem="{Binding SelectedOperator, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayText" />
                                <ComboBox Width="180"
                                          Margin="6,0,0,0"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          AutomationProperties.AutomationId="FilterOperandBox"
                                          ItemsSource="{Binding AllowedValues}"
                                          Text="{Binding Operand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Margin="6,0,0,0"
                                        Padding="8,0"
                                        AutomationProperties.AutomationId="FilterRemoveButton"
                                        Content="×"
                                        Command="{Binding RemoveCommand}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Expander>

        <Expander Grid.Row="3"
                  Margin="0,0,0,6"
                  Visibility="{Binding IsEmbedded, Converter={StaticResource InverseBoolToVisibility}}"
                  AutomationProperties.AutomationId="ColumnsExpander"
                  Header="{Binding ColumnsLabel}">
            <Grid Margin="4,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Text="{Binding ColumnSearchLabel}" />
                    <TextBox Width="220"
                             AutomationProperties.AutomationId="ColumnSearchBox"
                             Text="{Binding ColumnSearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Margin="10,0,6,0"
                            Padding="10,2"
                            AutomationProperties.AutomationId="DefaultColumnsButton"
                            Content="{Binding DefaultColumnsText}"
                            Command="{Binding ShowDefaultColumnsCommand}" />
                    <Button Padding="10,2"
                            AutomationProperties.AutomationId="AllColumnsButton"
                            Content="{Binding AllColumnsText}"
                            Command="{Binding ShowAllColumnsCommand}" />
                </StackPanel>
                <TextBlock Grid.Row="1"
                           Margin="0,2,0,2"
                           Foreground="#FF666666"
                           AutomationProperties.AutomationId="VisibleColumnCount"
                           Text="{Binding VisibleColumnCountText}" />
                <ListBox Grid.Row="2"
                         Height="180"
                         AutomationProperties.AutomationId="ColumnsList"
                         ItemsSource="{Binding Columns}"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                      Margin="2,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Margin="8,0,0,0"
                                               Foreground="#FF777777"
                                               Text="{Binding Description}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Expander>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="RowsGrid"
                  Grid.Column="0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  HeadersVisibility="All"
                  RowHeaderWidth="{Binding RowHeaderWidth}"
                  RowHeight="22"
                  ColumnHeaderHeight="26"
                  GridLinesVisibility="All"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  IsReadOnly="{Binding IsReadOnly}"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  Sorting="OnSorting"
                  SelectionChanged="OnSelectionChanged"
                  CurrentCellChanged="OnCurrentCellChanged"
                  ColumnReordered="OnColumnReordered"
                  PreviewMouseDoubleClick="OnRowsGridDoubleClick"
                  BeginningEdit="OnRowsGridBeginningEdit"
                  PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown">
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{Binding GoToTargetText}"
                                  Command="{Binding GoToTargetCommand}" />
                        <MenuItem Header="{Binding FilterByValueText}"
                                  Command="{Binding FilterByValueCommand}" />
                        <MenuItem Header="{Binding FilterExcludeValueText}"
                                  Command="{Binding ExcludeValueCommand}" />
                        <Separator />
                        <MenuItem Header="{Binding ResetLayoutText}"
                                  Command="{Binding ResetLayoutCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <ToggleButton Grid.Column="1"
                          Width="22"
                          Margin="4,0,0,0"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Center"
                          Focusable="False"
                          Cursor="Hand"
                          AutomationProperties.AutomationId="DetailsToggleButton"
                          AutomationProperties.Name="{Binding DetailToggleText}"
                          ToolTip="{Binding DetailToggleText}"
                          IsChecked="{Binding ShowDetails, Mode=TwoWay}"
                          Visibility="{Binding IsEmbedded, Converter={StaticResource InverseBoolToVisibility}}">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="#FF555555" />
                        <Setter Property="Content" Value="◀" />
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Content" Value="▶" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE8E8E8" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>

            <Border Grid.Column="2"
                    Width="340"
                    Margin="4,0,0,0"
                    BorderBrush="#FFB0B0B0"
                    BorderThickness="1"
                    Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}">
                <GroupBox Header="{Binding DetailHeader}" BorderThickness="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="6">
                            <ItemsControl ItemsSource="{Binding DetailImages}"
                                          Visibility="{Binding HasGraphicFields, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding Label}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="8,0,0,0"
                                                           HorizontalAlignment="Right"
                                                           Foreground="#FF666666"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding InfoText}" />
                                            </Grid>
                                            <Border Grid.Row="1"
                                                    Height="{Binding PanelHeight}"
                                                    Margin="0,2,0,0"
                                                    Background="{StaticResource CheckerBrush}"
                                                    BorderBrush="#FFAFAFAF"
                                                    BorderThickness="1">
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <Image Source="{Binding Image}"
                                                           Stretch="None"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                           SnapsToDevicePixels="True" />
                                                </ScrollViewer>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Margin="0,0,6,0"
                                           Text="{Binding DetailFilterLabel}" />
                                <TextBox Grid.Column="1"
                                         AutomationProperties.AutomationId="DetailFilterBox"
                                         Text="{Binding DetailFilter, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding DetailGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="0,2,0,2"
                                                  IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding Label}" />
                                                    <TextBlock Margin="8,0,0,0"
                                                               Foreground="#FF777777"
                                                               Text="{Binding FieldCountText}" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Fields}"
                                                          Margin="4,2,0,2">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <views:FieldEditor />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>
            </Border>
        </Grid>

        <Expander Grid.Row="5"
                  Margin="0,6,0,0"
                  Visibility="{Binding IsEmbedded, Converter={StaticResource InverseBoolToVisibility}}"
                  AutomationProperties.AutomationId="ValidationExpander"
                  Header="{Binding ValidationLabel}"
                  IsExpanded="{Binding IsValidationVisible, Mode=TwoWay}">
            <ListBox Height="130"
                     Margin="4,4,0,0"
                     AutomationProperties.AutomationId="ValidationList"
                     ItemsSource="{Binding ValidationIssues}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Expander>

        <Grid Grid.Row="6"
              Margin="0,6,0,0"
              Visibility="{Binding IsEmbedded, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar Grid.Row="0"
                         Height="4"
                         IsIndeterminate="True">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <TextBlock Grid.Row="1"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="EditorStatus"
                       Text="{Binding StatusText}" />
        </Grid>
    </Grid>
</UserControl>
