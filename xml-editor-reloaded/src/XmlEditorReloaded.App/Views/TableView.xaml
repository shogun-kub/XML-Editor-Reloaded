<UserControl x:Class="XmlEditorReloaded.App.Views.TableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <DrawingBrush x:Key="CheckerBrush"
                      TileMode="Tile"
                      Viewport="0,0,16,16"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,16,16"
                      ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFF2F2F2">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFD8D8D8">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontSize="15"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Text="{Binding Title}" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#FF666666"
                           Text="{Binding LanguageText}" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding RecordCountText}" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#FF666666"
                           Text="{Binding VisibleColumnCountText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           Text="{Binding SearchLabel}" />
                <TextBox Width="220"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,6">
            <Button Padding="10,3"
                    Margin="0,0,6,0"
                    Content="{Binding AddRowText}"
                    Command="{Binding AddRowCommand}"
                    IsEnabled="{Binding IsEditable}" />
            <Button Padding="10,3"
                    Margin="0,0,6,0"
                    Content="{Binding DuplicateRowText}"
                    Command="{Binding DuplicateRowCommand}"
                    IsEnabled="{Binding IsEditable}" />
            <Button Padding="10,3"
                    Margin="0,0,12,0"
                    Content="{Binding DeleteRowText}"
                    Command="{Binding DeleteRowCommand}"
                    IsEnabled="{Binding IsEditable}" />
            <Button Padding="10,3"
                    Margin="0,0,6,0"
                    Content="{Binding SaveText}"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsDirty}" />
            <Button Padding="10,3"
                    Margin="0,0,6,0"
                    Content="{Binding ValidateText}"
                    Command="{Binding ValidateCommand}" />
            <Button Padding="10,3"
                    Content="{Binding ReloadText}"
                    Command="{Binding ReloadCommand}" />
            <CheckBox Margin="14,0,0,0"
                      VerticalAlignment="Center"
                      Content="{Binding DetailLabel}"
                      IsChecked="{Binding ShowDetails, Mode=TwoWay}" />
        </StackPanel>

        <Expander Grid.Row="2"
                  Margin="0,0,0,6"
                  Header="{Binding ColumnsLabel}">
            <Grid Margin="4,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Text="{Binding ColumnSearchLabel}" />
                    <TextBox Width="220"
                             Text="{Binding ColumnSearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Margin="10,0,6,0"
                            Padding="10,2"
                            Content="{Binding DefaultColumnsText}"
                            Command="{Binding ShowDefaultColumnsCommand}" />
                    <Button Padding="10,2"
                            Content="{Binding AllColumnsText}"
                            Command="{Binding ShowAllColumnsCommand}" />
                </StackPanel>
                <TextBlock Grid.Row="1"
                           Margin="0,2,0,2"
                           Foreground="#FF666666"
                           Text="{Binding VisibleColumnCountText}" />
                <ListBox Grid.Row="2"
                         Height="180"
                         ItemsSource="{Binding Columns}"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                      Margin="2,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Margin="8,0,0,0"
                                               Foreground="#FF777777"
                                               Text="{Binding Description}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Expander>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="RowsGrid"
                  Grid.Column="0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  SelectionUnit="Cell"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  RowHeight="22"
                  ColumnHeaderHeight="26"
                  GridLinesVisibility="All"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  IsReadOnly="{Binding IsReadOnly}"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  Sorting="OnSorting" />

            <Border Grid.Column="1"
                    Width="340"
                    Margin="6,0,0,0"
                    BorderBrush="#FFB0B0B0"
                    BorderThickness="1"
                    Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}">
                <GroupBox Header="{Binding DetailHeader}" BorderThickness="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="6">
                            <ItemsControl ItemsSource="{Binding DetailImages}"
                                          Visibility="{Binding HasGraphicFields, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding Label}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="8,0,0,0"
                                                           HorizontalAlignment="Right"
                                                           Foreground="#FF666666"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding InfoText}" />
                                            </Grid>
                                            <Border Grid.Row="1"
                                                    Height="{Binding PanelHeight}"
                                                    Margin="0,2,0,0"
                                                    Background="{StaticResource CheckerBrush}"
                                                    BorderBrush="#FFAFAFAF"
                                                    BorderThickness="1">
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <Image Source="{Binding Image}"
                                                           Stretch="None"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                           SnapsToDevicePixels="True" />
                                                </ScrollViewer>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Margin="0,0,6,0"
                                           Text="{Binding DetailFilterLabel}" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding DetailFilter, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding DetailGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="0,2,0,2"
                                                  IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding Label}" />
                                                    <TextBlock Margin="8,0,0,0"
                                                               Foreground="#FF777777"
                                                               Text="{Binding FieldCountText}" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Fields}"
                                                          Margin="4,2,0,2">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="105" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding TypeText}"
                                                                       Text="{Binding Name}" />
                                                            <TextBox Grid.Column="1"
                                                                     Margin="4,0,0,0"
                                                                     Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                     IsReadOnly="{Binding IsReadOnly}" />
                                                            <Button Grid.Column="2"
                                                                    Margin="4,0,0,0"
                                                                    Padding="5,0"
                                                                    Content="{Binding DataContext.DetailBitsText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    Command="{Binding EditBitsCommand}"
                                                                    Visibility="{Binding CanEditBits, Converter={StaticResource BoolToVisibility}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>
            </Border>
        </Grid>

        <Expander Grid.Row="4"
                  Margin="0,6,0,0"
                  Header="{Binding ValidationLabel}"
                  IsExpanded="{Binding IsValidationVisible, Mode=TwoWay}">
            <ListBox Height="130"
                     Margin="4,4,0,0"
                     ItemsSource="{Binding ValidationIssues}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Expander>

        <Grid Grid.Row="5" Margin="0,6,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar Grid.Row="0"
                         Height="4"
                         IsIndeterminate="True">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <TextBlock Grid.Row="1"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding StatusText}" />
        </Grid>
    </Grid>
</UserControl>
