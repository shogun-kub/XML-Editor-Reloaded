<UserControl x:Class="XmlEditorReloaded.App.Views.TableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontSize="15"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Text="{Binding Title}" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#FF666666"
                           Text="{Binding LanguageText}" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding RecordCountText}" />
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#FF666666"
                           Text="{Binding VisibleColumnCountText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           Text="{Binding SearchLabel}" />
                <TextBox Width="220"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,6">
            <Button Padding="10,3"
                    Margin="0,0,6,0"
                    Content="{Binding AddRowText}"
                    Command="{Binding AddRowCommand}"
                    IsEnabled="{Binding IsEditable}" />
            <Button Padding="10,3"
                    Margin="0,0,6,0"
                    Content="{Binding DuplicateRowText}"
                    Command="{Binding DuplicateRowCommand}"
                    IsEnabled="{Binding IsEditable}" />
            <Button Padding="10,3"
                    Margin="0,0,12,0"
                    Content="{Binding DeleteRowText}"
                    Command="{Binding DeleteRowCommand}"
                    IsEnabled="{Binding IsEditable}" />
            <Button Padding="10,3"
                    Margin="0,0,6,0"
                    Content="{Binding SaveText}"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsDirty}" />
            <Button Padding="10,3"
                    Margin="0,0,6,0"
                    Content="{Binding ValidateText}"
                    Command="{Binding ValidateCommand}" />
            <Button Padding="10,3"
                    Content="{Binding ReloadText}"
                    Command="{Binding ReloadCommand}" />
        </StackPanel>

        <Expander Grid.Row="2"
                  Margin="0,0,0,6"
                  Header="{Binding ColumnsLabel}">
            <Grid Margin="4,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Text="{Binding ColumnSearchLabel}" />
                    <TextBox Width="220"
                             Text="{Binding ColumnSearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Margin="10,0,6,0"
                            Padding="10,2"
                            Content="{Binding DefaultColumnsText}"
                            Command="{Binding ShowDefaultColumnsCommand}" />
                    <Button Padding="10,2"
                            Content="{Binding AllColumnsText}"
                            Command="{Binding ShowAllColumnsCommand}" />
                </StackPanel>
                <TextBlock Grid.Row="1"
                           Margin="0,2,0,2"
                           Foreground="#FF666666"
                           Text="{Binding VisibleColumnCountText}" />
                <ListBox Grid.Row="2"
                         Height="180"
                         ItemsSource="{Binding Columns}"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                      Margin="2,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Margin="8,0,0,0"
                                               Foreground="#FF777777"
                                               Text="{Binding Description}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Expander>

        <DataGrid x:Name="RowsGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  SelectionUnit="Cell"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  RowHeight="22"
                  ColumnHeaderHeight="26"
                  GridLinesVisibility="All"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  IsReadOnly="{Binding IsReadOnly}"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  Sorting="OnSorting" />

        <Expander Grid.Row="4"
                  Margin="0,6,0,0"
                  Header="{Binding ValidationLabel}"
                  IsExpanded="{Binding IsValidationVisible, Mode=TwoWay}">
            <ListBox Height="130"
                     Margin="4,4,0,0"
                     ItemsSource="{Binding ValidationIssues}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Expander>

        <Grid Grid.Row="5" Margin="0,6,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar Grid.Row="0"
                         Height="4"
                         IsIndeterminate="True">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <TextBlock Grid.Row="1"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding StatusText}" />
        </Grid>
    </Grid>
</UserControl>
