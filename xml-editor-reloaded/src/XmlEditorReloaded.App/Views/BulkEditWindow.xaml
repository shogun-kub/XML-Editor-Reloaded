<Window x:Class="XmlEditorReloaded.App.Views.BulkEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="840"
        Height="560"
        MinWidth="680"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Grid.Row="0"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"
                       Text="{Binding ColumnLabel}" />
            <ComboBox Grid.Column="1"
                      Grid.Row="0"
                      Margin="0,0,6,0"
                      VerticalAlignment="Center"
                      AutomationProperties.AutomationId="BulkEditColumnCombo"
                      ItemsSource="{Binding Columns}"
                      SelectedItem="{Binding SelectedColumn, Mode=TwoWay}"
                      DisplayMemberPath="DisplayText" />
            <TextBlock Grid.Column="2"
                       Grid.Row="0"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"
                       Text="{Binding OperationLabel}" />
            <ComboBox Grid.Column="3"
                      Grid.Row="0"
                      Margin="0,0,6,0"
                      VerticalAlignment="Center"
                      AutomationProperties.AutomationId="BulkEditOperationCombo"
                      ItemsSource="{Binding Operations}"
                      SelectedItem="{Binding SelectedOperation, Mode=TwoWay}"
                      DisplayMemberPath="DisplayText" />
            <TextBlock Grid.Column="4"
                       Grid.Row="0"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"
                       Text="{Binding ValueLabel}" />
            <ComboBox Grid.Column="5"
                      Grid.Row="0"
                      VerticalAlignment="Center"
                      IsEditable="True"
                      IsTextSearchEnabled="False"
                      AutomationProperties.AutomationId="BulkEditOperandBox"
                      ItemsSource="{Binding AllowedValues}"
                      Text="{Binding OperandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding IsOperandEnabled}"
                      IsKeyboardFocusWithinChanged="OnOperandFocusWithinChanged"
                      DropDownClosed="OnOperandDropDownClosed">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ListText}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Column="5"
                       Grid.Row="1"
                       Margin="0,6,0,0"
                       FontSize="11"
                       Foreground="#FF666666"
                       TextWrapping="Wrap"
                       Text="{Binding OperandHintText}"
                       Visibility="{Binding HasOperandHint, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,6">
            <CheckBox Margin="0,0,6,0"
                      Content="{Binding IncludeMissingText}"
                      ToolTip="{Binding IncludeMissingTooltip}"
                      IsChecked="{Binding IncludeMissingFields, Mode=TwoWay}" />
            <CheckBox Content="{Binding ClearValueText}"
                      ToolTip="{Binding ClearValueTooltip}"
                      IsChecked="{Binding ClearValue, Mode=TwoWay}"
                      IsEnabled="{Binding CanClearValue}" />
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Margin="0,0,0,6"
                   Foreground="#FF666666"
                   AutomationProperties.AutomationId="BulkEditTarget"
                   Text="{Binding TargetText}" />

        <TextBlock Grid.Row="3"
                   Margin="0,0,0,6"
                   FontWeight="SemiBold"
                   AutomationProperties.AutomationId="BulkEditSummary"
                   Text="{Binding SummaryText}" />

        <DataGrid x:Name="PreviewGrid"
                  Grid.Row="4"
                  AutomationProperties.AutomationId="BulkEditPreviewGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="True"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  EnableRowVirtualization="True"
                  ItemsSource="{Binding PreviewRows}">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="KeyColumn" Binding="{Binding RecordKey}" Width="90" />
                <DataGridTextColumn x:Name="OldColumn" Binding="{Binding OldValue}" Width="240" />
                <DataGridTextColumn x:Name="NewColumn" Binding="{Binding NewValue}" Width="240" />
                <DataGridTextColumn x:Name="StatusColumn" Binding="{Binding StatusText}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="5"
                   Margin="0,6,0,0"
                   Foreground="#FFB00020"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="BulkEditError"
                   Text="{Binding ErrorText}"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Margin="0,6,6,0"
                    Padding="16,4"
                    IsDefault="True"
                    AutomationProperties.AutomationId="BulkEditApplyButton"
                    Content="{Binding ApplyText}"
                    IsEnabled="{Binding CanApply}"
                    Click="OnApply" />
            <Button Margin="0,6,0,0"
                    Padding="16,4"
                    IsCancel="True"
                    AutomationProperties.AutomationId="BulkEditCancelButton"
                    Content="{Binding CancelText}"
                    Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
