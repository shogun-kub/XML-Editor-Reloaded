<Window x:Class="XmlEditorReloaded.App.Views.BulkEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="840"
        Height="560"
        MinWidth="680"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"
                       Text="{Binding ColumnLabel}" />
            <ComboBox Grid.Column="1"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding Columns}"
                      SelectedItem="{Binding SelectedColumn, Mode=TwoWay}"
                      DisplayMemberPath="DisplayText" />
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"
                       Text="{Binding OperationLabel}" />
            <ComboBox Grid.Column="3"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding Operations}"
                      SelectedItem="{Binding SelectedOperation, Mode=TwoWay}"
                      DisplayMemberPath="DisplayText" />
            <TextBlock Grid.Column="4"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"
                       Text="{Binding ValueLabel}" />
            <TextBox Grid.Column="5"
                     VerticalAlignment="Center"
                     Text="{Binding Operand, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <CheckBox Grid.Row="1"
                  Margin="0,0,0,4"
                  Content="{Binding IncludeMissingText}"
                  ToolTip="{Binding IncludeMissingTooltip}"
                  IsChecked="{Binding IncludeMissingFields, Mode=TwoWay}" />

        <TextBlock Grid.Row="2"
                   Margin="0,0,0,2"
                   Foreground="#FF666666"
                   Text="{Binding TargetText}" />

        <TextBlock Grid.Row="3"
                   Margin="0,0,0,6"
                   FontWeight="SemiBold"
                   Text="{Binding SummaryText}" />

        <DataGrid x:Name="PreviewGrid"
                  Grid.Row="4"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="True"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  EnableRowVirtualization="True"
                  ItemsSource="{Binding PreviewRows}">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="KeyColumn" Binding="{Binding RecordKey}" Width="90" />
                <DataGridTextColumn x:Name="OldColumn" Binding="{Binding OldValue}" Width="240" />
                <DataGridTextColumn x:Name="NewColumn" Binding="{Binding NewValue}" Width="240" />
                <DataGridTextColumn x:Name="StatusColumn" Binding="{Binding StatusText}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="5"
                   Margin="0,6,0,0"
                   Foreground="#FFB00020"
                   TextWrapping="Wrap"
                   Text="{Binding ErrorText}"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Margin="0,10,8,0"
                    Padding="16,4"
                    IsDefault="True"
                    Content="{Binding ApplyText}"
                    IsEnabled="{Binding CanApply}"
                    Click="OnApply" />
            <Button Margin="0,10,0,0"
                    Padding="16,4"
                    IsCancel="True"
                    Content="{Binding CancelText}"
                    Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
