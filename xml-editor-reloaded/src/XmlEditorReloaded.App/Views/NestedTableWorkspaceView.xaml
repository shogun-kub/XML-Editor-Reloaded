<UserControl x:Class="XmlEditorReloaded.App.Views.NestedTableWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:XmlEditorReloaded.App.Views"
             xmlns:shortcuts="clr-namespace:XmlEditorReloaded.App.Shortcuts"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
        <KeyBinding Key="F8" Command="{Binding ValidateCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0">
                <Button Style="{DynamicResource IconButton}"
                        Margin="0,0,4,0"
                        AutomationProperties.AutomationId="NestedUndoButton"
                        AutomationProperties.Name="{Binding UndoText}"
                        Content="{DynamicResource Icon.Undo}"
                        Command="{Binding UndoCommand}"
                        ToolTip="{Binding UndoText}" />
                <Button Style="{DynamicResource IconButton}"
                        Margin="0,0,4,0"
                        AutomationProperties.AutomationId="NestedRedoButton"
                        AutomationProperties.Name="{Binding RedoText}"
                        Content="{DynamicResource Icon.Redo}"
                        Command="{Binding RedoCommand}"
                        ToolTip="{Binding RedoText}" />
                <Button Style="{DynamicResource IconButton}"
                        Margin="0,0,4,0"
                        AutomationProperties.AutomationId="NestedSaveButton"
                        AutomationProperties.Name="{Binding SaveText}"
                        Content="{DynamicResource Icon.Save}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsDirty}"
                        ToolTip="{shortcuts:ShortcutTip Action=Save, Text={Binding SaveText}}" />
                <Button Style="{DynamicResource IconButton}"
                        Margin="0,0,4,0"
                        AutomationProperties.AutomationId="NestedAddButton"
                        AutomationProperties.Name="{Binding AddRecordText}"
                        Content="{DynamicResource Icon.AddRow}"
                        Command="{Binding AddRecordCommand}"
                        ToolTip="{shortcuts:ShortcutTip Action=AddRow, Text={Binding AddRecordText}}" />
                <Button Style="{DynamicResource IconButton}"
                        Margin="0,0,4,0"
                        AutomationProperties.AutomationId="NestedDeleteButton"
                        AutomationProperties.Name="{Binding DeleteRecordText}"
                        Content="{DynamicResource Icon.Delete}"
                        Command="{Binding DeleteRecordCommand}"
                        ToolTip="{shortcuts:ShortcutTip Action=DeleteRow, Text={Binding DeleteRecordText}}" />
                <Button Style="{DynamicResource IconButton}"
                        Margin="0,0,4,0"
                        AutomationProperties.AutomationId="NestedValidateButton"
                        AutomationProperties.Name="{Binding ValidateText}"
                        Content="{DynamicResource Icon.Validate}"
                        Command="{Binding ValidateCommand}"
                        ToolTip="{shortcuts:ShortcutTip Action=Validate, Text={Binding ValidateText}}" />
                <Button Style="{DynamicResource IconButton}"
                        AutomationProperties.AutomationId="NestedReloadButton"
                        AutomationProperties.Name="{Binding ReloadText}"
                        Content="{DynamicResource Icon.Reload}"
                        Command="{Binding ReloadCommand}"
                        ToolTip="{shortcuts:ShortcutTip Action=Reload, Text={Binding ReloadText}}" />
            </WrapPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Margin="6,0,0,0">
                <TextBlock VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           Text="{Binding LanguageLabel}" />
                <ComboBox Width="160"
                          VerticalAlignment="Center"
                          AutomationProperties.AutomationId="NestedLanguageCombo"
                          ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}"
                          DisplayMemberPath="DisplayText"
                          ToolTip="{Binding SelectedLanguageOption.Tooltip}"
                          IsEnabled="{Binding IsLanguageSelectorEnabled}" />
            </StackPanel>
        </Grid>

        <WrapPanel Grid.Row="1"
                   Margin="0,0,0,6"
                   Visibility="{Binding HasNestedAddActions, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,6,0"
                        Visibility="{Binding HasAssignmentSegment, Converter={StaticResource BoolToVisibility}}">
                <TextBlock VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           Text="{Binding NewAssignmentTypeLabel}" />
                <TextBox Width="140"
                         Margin="0,0,6,0"
                         VerticalAlignment="Center"
                         AutomationProperties.AutomationId="NestedNewAssignmentTypeBox"
                         Text="{Binding NewAssignmentType, UpdateSourceTrigger=PropertyChanged}" />
                <Button Padding="10,3"
                        AutomationProperties.AutomationId="NestedAddAssignmentButton"
                        Content="{Binding AddAssignmentText}"
                        Command="{Binding AddAssignmentCommand}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding BlockAddActions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Padding="10,3"
                                Margin="0,0,6,6"
                                AutomationProperties.AutomationId="{Binding AutomationId}"
                                Content="{Binding Text}"
                                Command="{Binding Command}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="{Binding Title}" Margin="0,0,6,0">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Text="{Binding SearchLabel}" />
                        <TextBox Grid.Column="1"
                                 AutomationProperties.AutomationId="NestedSearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <TextBlock Grid.Row="1"
                               Margin="0,0,0,6"
                               FontSize="11"
                               Foreground="{DynamicResource Theme.Text.Muted}"
                               AutomationProperties.AutomationId="NestedCountText"
                               Text="{Binding RecordCountText}" />
                    <ListBox Grid.Row="2"
                             AutomationProperties.AutomationId="NestedRecordList"
                             ItemsSource="{Binding Records}"
                             SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                             DisplayMemberPath="DisplayName" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="{Binding DetailHeader}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sections}" Margin="6"
                                  AutomationProperties.AutomationId="NestedSections">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,0,0,6"
                                          IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="{Binding AutomationId}">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Header}" />
                                            <Button Margin="6,0,0,0"
                                                    Padding="8,0"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="{Binding DeleteAutomationId}"
                                                    Command="{Binding DataContext.DeleteSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding DeleteText}"
                                                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="6,3,0,3">
                                        <ItemsControl ItemsSource="{Binding Fields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <views:FieldEditor />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Lists}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <GroupBox Margin="0,0,0,6"
                                                              Header="{Binding Label}"
                                                              AutomationProperties.AutomationId="{Binding PathText}">
                                                        <StackPanel Margin="6">
                                                            <ItemsControl ItemsSource="{Binding Values}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <DockPanel Margin="0,0,0,6">
                                                                            <Button DockPanel.Dock="Right"
                                                                                    Margin="6,0,0,0"
                                                                                    Padding="8,1"
                                                                                    AutomationProperties.AutomationId="{Binding RemoveAutomationId}"
                                                                                    Command="{Binding RemoveCommand}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Content="{Binding RemoveText}"
                                                                                    IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                                            <TextBox AutomationProperties.AutomationId="{Binding ValueAutomationId}"
                                                                                     Text="{Binding Value, UpdateSourceTrigger=LostFocus}" />
                                                                        </DockPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Margin="0,6,0,0"
                                                                    Padding="10,2"
                                                                    HorizontalAlignment="Left"
                                                                    AutomationProperties.AutomationId="{Binding AddAutomationId}"
                                                                    Command="{Binding AddCommand}"
                                                                    Content="{Binding AddText}"
                                                                    IsEnabled="{Binding CanEdit}" />
                                                        </StackPanel>
                                                    </GroupBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="3"
                  Margin="0,6,0,0"
                  Header="{Binding ValidationLabel}"
                  Visibility="{Binding IsValidationVisible, Converter={StaticResource BoolToVisibility}}">
            <ListBox Height="120"
                     AutomationProperties.AutomationId="NestedValidationList"
                     ItemsSource="{Binding ValidationIssues}"
                     DisplayMemberPath="Text" />
        </GroupBox>

        <TextBlock Grid.Row="4"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="NestedStatusText"
                   Text="{Binding StatusText}" />
    </Grid>
</UserControl>
