<UserControl x:Class="XmlEditorReloaded.App.Views.NestedTableWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:XmlEditorReloaded.App.Views"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0">
                <Button Padding="10,3"
                        Margin="0,0,6,0"
                        AutomationProperties.AutomationId="NestedUndoButton"
                        Content="{Binding UndoText}"
                        Command="{Binding UndoCommand}" />
                <Button Padding="10,3"
                        Margin="0,0,12,0"
                        AutomationProperties.AutomationId="NestedRedoButton"
                        Content="{Binding RedoText}"
                        Command="{Binding RedoCommand}" />
                <Button Padding="10,3"
                        Margin="0,0,6,0"
                        AutomationProperties.AutomationId="NestedSaveButton"
                        Content="{Binding SaveText}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsDirty}" />
                <Button Padding="10,3"
                        Margin="0,0,6,0"
                        AutomationProperties.AutomationId="NestedAddButton"
                        Content="{Binding AddRecordText}"
                        Command="{Binding AddRecordCommand}" />
                <Button Padding="10,3"
                        Margin="0,0,6,0"
                        AutomationProperties.AutomationId="NestedDeleteButton"
                        Content="{Binding DeleteRecordText}"
                        Command="{Binding DeleteRecordCommand}" />
                <Button Padding="10,3"
                        Margin="0,0,6,0"
                        AutomationProperties.AutomationId="NestedValidateButton"
                        Content="{Binding ValidateText}"
                        Command="{Binding ValidateCommand}" />
                <Button Padding="10,3"
                        Margin="0,0,12,0"
                        AutomationProperties.AutomationId="NestedReloadButton"
                        Content="{Binding ReloadText}"
                        Command="{Binding ReloadCommand}" />
            </WrapPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Margin="8,2,0,0">
                <TextBlock VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           Text="{Binding LanguageLabel}" />
                <ComboBox Width="160"
                          VerticalAlignment="Center"
                          AutomationProperties.AutomationId="NestedLanguageCombo"
                          ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}"
                          DisplayMemberPath="DisplayText"
                          ToolTip="{Binding SelectedLanguageOption.Tooltip}"
                          IsEnabled="{Binding IsLanguageSelectorEnabled}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="{Binding Title}" Margin="0,0,8,0">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Text="{Binding SearchLabel}" />
                        <TextBox Grid.Column="1"
                                 AutomationProperties.AutomationId="NestedSearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <TextBlock Grid.Row="1"
                               Margin="0,0,0,4"
                               FontSize="11"
                               Foreground="#FF666666"
                               AutomationProperties.AutomationId="NestedCountText"
                               Text="{Binding RecordCountText}" />
                    <ListBox Grid.Row="2"
                             AutomationProperties.AutomationId="NestedRecordList"
                             ItemsSource="{Binding Records}"
                             SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                             DisplayMemberPath="DisplayName" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="{Binding DetailHeader}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sections}" Margin="4"
                                  AutomationProperties.AutomationId="NestedSections">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,0,0,4"
                                          IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                          AutomationProperties.AutomationId="{Binding AutomationId}">
                                    <Expander.Header>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Header}" />
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Fields}" Margin="4,2,0,2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <views:FieldEditor />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="2"
                  Margin="0,6,0,0"
                  Header="{Binding ValidationLabel}"
                  Visibility="{Binding IsValidationVisible, Converter={StaticResource BoolToVisibility}}">
            <ListBox Height="120"
                     AutomationProperties.AutomationId="NestedValidationList"
                     ItemsSource="{Binding ValidationIssues}"
                     DisplayMemberPath="Text" />
        </GroupBox>

        <TextBlock Grid.Row="3"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   AutomationProperties.AutomationId="NestedStatusText"
                   Text="{Binding StatusText}" />
    </Grid>
</UserControl>
